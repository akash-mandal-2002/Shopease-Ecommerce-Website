PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Required: JWT secret (at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required: MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopease?retryWrites=true&w=majority

# Admin seed credentials (optional but recommended)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password

# Product sync (optional)
USE_DUMMYJSON_PRODUCTS=false
DUMMYJSON_PRICE_MULTIPLIER=85

# SMTP Email Configuration (required for email verification in production)
# In development, if not set, OTPs are printed to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
